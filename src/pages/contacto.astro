---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import Abstract from '../components/Abstract.astro';
import { photos } from '../content/photos';
import { contacto as c } from '../content/contacto';
import { contactChannels as ch } from '../content/site';
import { SITE_URL, providerRef } from '../lib/seo';

const contactSchema = [
  { '@type': 'ContactPage', '@id': `${SITE_URL}/contacto#page`, url: `${SITE_URL}/contacto`, name: c.meta.title, about: providerRef },
];

const L = c.form.labels;
const field = 'mt-2 w-full rounded-xl border border-ink/25 bg-white px-4 py-3.5 font-display text-base font-normal text-ink placeholder:text-ink/40 focus:border-azul';
const label = 'block font-display text-sm font-semibold';
---

<Base title={c.meta.title} description={c.meta.description} crumb="Contacto" schema={contactSchema}>
  <PageHero {...c.hero} image={photos.contactoHero} position="center 45%" />

  <section class="section relative isolate overflow-hidden">
    <Abstract variant="grid" tone="light" />
    <div class="container-fedes relative grid gap-16 lg:grid-cols-[1fr_1.4fr] lg:gap-24">
      <aside data-reveal>
        <h2 class="text-3xl sm:text-4xl">{c.incluye.title}</h2>
        <ul class="mt-8 space-y-5">
          {
            c.incluye.items.map((t) => (
              <li class="flex gap-4 border-t border-ink/15 pt-5">
                <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span class="lead">{t}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="eyebrow mt-16 text-azul">{c.otrasVias}</h3>
        <ul class="mt-6 space-y-3 font-display text-base">
          <li><a class="underline decoration-accent decoration-2 underline-offset-4 hover:text-azul" href={ch.whatsapp.href}>WhatsApp {ch.whatsapp.label}</a></li>
          <li><a class="underline decoration-accent decoration-2 underline-offset-4 hover:text-azul" href={ch.email.href}>{ch.email.label}</a></li>
          <li><a class="underline decoration-accent decoration-2 underline-offset-4 hover:text-azul" href={ch.linkedin.href} target="_blank" rel="noopener">{ch.linkedin.label}</a></li>
          <li class="text-ink/70">{ch.location}</li>
        </ul>
      </aside>

      <div>
        <!-- Paso 1: contanos sobre tu empresa -->
        <div id="paso-datos" data-reveal style="--d:100ms">
          <h2 class="text-3xl sm:text-4xl">{c.pasoDatos.title}</h2>
          <p class="lead mt-4 text-ink/70">{c.pasoDatos.body}</p>

          <form id="contact-form" method="post" action="/api/contacto" class="mt-8 space-y-6" novalidate>
            <div class="grid gap-6 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="nombre" class={label}>{L.nombre}</label>
                <input id="nombre" name="nombre" type="text" autocomplete="name" required class={field} />
              </div>
              <div>
                <label for="empresa" class={label}>{L.empresa}</label>
                <input id="empresa" name="empresa" type="text" autocomplete="organization" required class={field} />
              </div>
              <div>
                <label for="email" class={label}>{L.email}</label>
                <input id="email" name="email" type="email" autocomplete="email" required class={field} />
              </div>
              <div>
                <label for="tamano" class={label}>{L.tamano}</label>
                <select id="tamano" name="tamano" required class={field}>
                  <option value="">{c.form.tamanoPlaceholder}</option>
                  {c.form.tamanoOptions.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>
              <div>
                <label for="resolver" class={label}>{L.resolver}</label>
                <select id="resolver" name="resolver" required class={field}>
                  <option value="">{c.form.resolverPlaceholder}</option>
                  {c.form.resolverOptions.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>
            </div>

            <!-- Anti-spam: campo señuelo que las personas no ven -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label>No completar<input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
            </div>

            <!-- De dónde vino, si llegó con "?ruta=" (para métricas del panel, no lo completa la persona) -->
            <input type="hidden" id="ruta_referido" name="ruta_referido" value="" />

            <label class="flex items-start gap-3 font-display text-sm">
              <input type="checkbox" name="privacidad" required class="mt-1 h-4 w-4 accent-azul" />
              <span>{c.form.privacyPrefix} <a href={c.form.privacyLink.href} class="underline underline-offset-4 hover:text-azul" target="_blank">{c.form.privacyLink.label}</a>.</span>
            </label>

            <p id="form-error" role="alert" class="hidden rounded-xl border border-ink/30 bg-ink/[0.04] px-4 py-3 font-display text-sm"></p>

            <button type="submit" class="btn btn-primary" id="form-submit">{c.form.submit}<Arrow /></button>
          </form>
        </div>

        <!-- Paso 2: elegí un horario (aparece al enviar el paso 1, mismo lugar, mismo trámite) -->
        <div id="paso-horario" data-reveal class="hidden">
          <p id="transicion-msg" role="status" class="font-display text-sm font-semibold text-azul"></p>
          <h2 class="mt-3 text-3xl sm:text-4xl">{c.calendario.title}</h2>
          <p class="lead mt-4 text-ink/70">{c.calendario.body}</p>
          <div class="mt-8 overflow-hidden rounded-3xl border border-ink/15 bg-white">
            <iframe
              src={c.calendario.embedUrl}
              title={c.calendario.embedTitle}
              loading="lazy"
              class="block h-[780px] w-full"
              style="border:0"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trabajá con nosotros: sección propia, al final -->
  <section class="relative isolate overflow-hidden bg-ink py-20 text-white md:py-28">
    <Abstract variant="arcs" />
    <div class="container-fedes relative mx-auto max-w-2xl text-center">
      <p class="eyebrow text-celeste">{c.trabajos.eyebrow}</p>
      <h2 class="mt-6 text-3xl sm:text-4xl">{c.trabajos.title}</h2>
      <p class="lead mx-auto mt-4 max-w-xl text-white/80">{c.trabajos.body}</p>
      <a href={`mailto:${c.trabajos.email}`} class="btn btn-light mt-8">
        Escribir a {c.trabajos.email}
        <Arrow />
      </a>
    </div>
  </section>

  <script>
    // Si se llega desde un botón "Quiero empezar por <ruta>" (Onboardings o Consultoría),
    // preseleccionar esa opción en "¿Qué querés resolver?".
    const ruta = new URLSearchParams(location.search).get('ruta');
    const resolver = document.getElementById('resolver') as HTMLSelectElement | null;
    const rutaReferido = document.getElementById('ruta_referido') as HTMLInputElement | null;
    if (ruta) {
      if (rutaReferido) rutaReferido.value = ruta;
      if (resolver && [...resolver.options].some((o) => o.value === ruta)) {
        resolver.value = ruta;
      }
    }
  </script>

  <script define:vars={{ sending: c.form.sending, errorText: c.form.error }}>
    const form = document.getElementById('contact-form');
    const btn = document.getElementById('form-submit');
    const err = document.getElementById('form-error');
    const pasoDatos = document.getElementById('paso-datos');
    const pasoHorario = document.getElementById('paso-horario');
    const transicionMsg = document.getElementById('transicion-msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      if (!form.reportValidity()) return;
      btn.disabled = true;
      const prev = btn.innerHTML;
      btn.textContent = sending;
      try {
        const data = new FormData(form);
        const res = await fetch(form.action, { method: 'POST', body: data });
        if (!res.ok) throw new Error(String(res.status));

        const nombre = String(data.get('nombre') || '').trim().split(' ')[0];
        transicionMsg.textContent = `¡Gracias${nombre ? ', ' + nombre : ''}! Ahora elegí un horario para tu sesión.`;

        pasoDatos.classList.add('hidden');
        pasoHorario.classList.remove('hidden');
        // Deja que el navegador pinte el estado "hidden" quitado antes de animar la entrada.
        requestAnimationFrame(() => pasoHorario.classList.add('is-visible'));
        pasoHorario.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch {
        err.textContent = errorText;
        err.classList.remove('hidden');
        btn.innerHTML = prev;
        btn.disabled = false;
      }
    });
  </script>
</Base>
