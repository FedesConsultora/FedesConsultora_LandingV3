---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import Abstract from '../components/Abstract.astro';
import { photos } from '../content/photos';
import { consultoria as c } from '../content/consultoria';
---

<Base title={c.meta.title} description={c.meta.description} crumb="Consultoría">
  <PageHero {...c.hero} image={photos.consultoriaHero} position="center 35%" />

  <!-- Onboarding de 60 días -->
  <section class="section">
    <div class="container-fedes grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <h2 data-reveal class="text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">{c.onboarding.title}</h2>
      <p data-reveal style="--d:150ms" class="lead text-ink/80 lg:pt-3">{c.onboarding.body}</p>
    </div>
  </section>

  <!-- Tres rutas, resumidas: el detalle de cada onboarding vive en /onboardings -->
  <section class="relative isolate overflow-hidden bg-azul/[0.06] py-20 md:py-28">
    <Abstract variant="grid" tone="light" />
    <div class="container-fedes relative">
      <div data-reveal class="border-t border-ink/20 pt-6">
        <p class="eyebrow text-azul">Tres rutas</p>
      </div>
      <h2 data-reveal style="--d:80ms" class="mt-8 max-w-3xl text-3xl leading-[1.05] sm:text-5xl">
        {c.nivelesNota} Cada ruta agrupa sus propios onboardings.
      </h2>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          c.rutas.map((r, i) => (
            <div data-reveal style={`--d:${i * 100}ms`} class="flex flex-col rounded-3xl border border-ink/15 bg-white p-8">
              <span class="font-display text-sm font-semibold text-azul">{r.number}</span>
              <h3 class="mt-8 text-xl">{r.name}</h3>
              <p class="mt-2 font-display text-sm font-medium italic text-azul">{r.question}</p>
              <ul class="mt-6 flex-1 space-y-2 border-t border-ink/10 pt-5 text-sm text-ink/70">
                {r.levels.map((l) => (
                  <li class="flex items-baseline gap-2">
                    <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-azul/50" />
                    <span>
                      {l.name}
                      {l.includes && <span class="text-ink/40"> · incluye {l.includes}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <a data-reveal href="/onboardings" class="btn btn-primary mt-10">
        Ver el detalle de cada onboarding
        <Arrow />
      </a>
    </div>
  </section>

  <!-- ¿Por dónde empezar? -->
  <section class="relative isolate overflow-hidden bg-azul text-white">
    <Abstract variant="outline" word="60" />
    <div class="container-fedes relative grid gap-8 py-16 md:grid-cols-[1fr_1.4fr] md:items-center md:py-20">
      <h2 class="text-3xl sm:text-4xl">{c.porDondeEmpezar.title}</h2>
      <p class="lead text-white/90">{c.porDondeEmpezar.body}</p>
    </div>
  </section>

  <!-- Después del onboarding -->
  <section class="section">
    <div class="container-fedes grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow text-azul">Después del onboarding</p>
        <h2 class="mt-6 text-4xl leading-[1.05] sm:text-5xl">{c.despues.title}</h2>
      </div>
      <div>
        <p class="lead text-ink/80">{c.despues.body}</p>
      </div>
    </div>
  </section>

  <!-- Tecnología -->
  <section class="section relative isolate overflow-hidden bg-ink text-white">
    <Abstract variant="arcs" />
    <div class="container-fedes relative">
      <p class="eyebrow text-celeste">Tecnología</p>
      <h2 class="mt-6 max-w-4xl text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">{c.tecnologia.title}</h2>
      <p class="lead mt-8 max-w-2xl text-white/80">{c.tecnologia.body}</p>

      <div data-reveal class="mt-14 rounded-3xl border border-white/20 bg-ink/50 p-8 backdrop-blur-sm md:p-12">
        <div class="flex flex-wrap items-center gap-4">
          <h3 class="text-3xl md:text-4xl">{c.tecnologia.vaddar.name}</h3>
          <span class="pill text-accent">{c.tecnologia.vaddar.badge}</span>
        </div>
        <p class="lead mt-6 max-w-3xl text-white/80">{c.tecnologia.vaddar.body}</p>
        <a href={c.tecnologia.vaddar.cta.href} class="btn btn-light mt-10">{c.tecnologia.vaddar.cta.label}<Arrow /></a>
      </div>
    </div>
  </section>

  <CtaBand {...c.cierre} />
</Base>
