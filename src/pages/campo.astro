---
// Landing de campaña para los avisos QR de las revistas La Rural y Angus (docs/10-landing-campo.md).
// Se renderiza en el servidor para elegir los textos según utm_source antes de enviar el HTML:
// sin parpadeo ni saltos de diseño, y funciona aunque el navegador no ejecute JavaScript.
// No aparece en el menú ni en el sitemap.
export const prerender = false;

import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/hanken-grotesk/800.css';
import '@fontsource/hanken-grotesk/900.css';
import Campana from '../layouts/Campana.astro';
import { campo, ORIGENES, CALENDAR_URL, WHATSAPP_NUMBER, origenDe } from '../content/campo';

const key = origenDe(Astro.url.searchParams.get('utm_source'));
const o = ORIGENES[key];
const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(o.wa)}`;
const { meta, hero, dolores, ordenamos, reunion, prueba, faq, cierre, footer, barra } = campo;

const heroSrcset = (ext: string) => `/agro/hero-campo-900.${ext} 900w, /agro/hero-campo-1800.${ext} 1800w`;
---

<Campana
  title={meta.title}
  description={meta.description}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage="/agro/og-campo.jpg"
  themeColor="#14303D"
  preload={[{ href: '/agro/hero-campo-900.webp', imagesrcset: heroSrcset('webp'), imagesizes: '100vw', type: 'image/webp' }]}
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="i-cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></symbol>
      <symbol id="i-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z"></path></symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></symbol>
      <symbol id="i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 0-14.3-4.9L4 8"></path><path d="M4 4v4h4"></path><path d="M4 13a8 8 0 0 0 14.3 4.9L20 16"></path><path d="M20 20v-4h-4"></path></symbol>
      <symbol id="i-proc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect><path d="M6.5 10v4a3 3 0 0 0 3 3H14"></path></symbol>
      <symbol id="i-mkt" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a1 1 0 0 0 1 1h3l7 4V6l-7 4H4a1 1 0 0 0-1 1Z"></path><path d="M18 9a4 4 0 0 1 0 6"></path></symbol>
      <symbol id="i-num" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V11M10 20V5M16 20v-6M2 20h20"></path></symbol>
      <symbol id="i-com" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"></path><path d="M15 7h6v6"></path></symbol>
      <symbol id="i-tel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path></symbol>
      <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect><path d="m3 6 9 7 9-7"></path></symbol>
      <symbol id="i-ig" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></symbol>
    </defs>
  </svg>

  <header class="hero">
    <picture>
      <source type="image/webp" srcset={heroSrcset('webp')} sizes="100vw" />
      <img class="hero__img" src="/agro/hero-campo-900.jpg" srcset={heroSrcset('jpg')} sizes="100vw" width="1800" height="1344" fetchpriority="high" alt={hero.imgAlt} />
    </picture>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="wrap hero__top in d0">
      <img class="hero__logo" src="/agro/logo-fedes.svg" width="180" height="67" alt="Fedes Consultora" />
      <div class="pill">{hero.pill}</div>
    </div>

    <div class="wrap hero__body">
      {
        o.label && (
          <div class="origin in d0">
            <span class="dot" aria-hidden="true" />
            <span>Viste nuestro aviso en {o.label}</span>
          </div>
        )
      }
      <h1 class="h1">
        <span class="in d1">{hero.h1[0]}</span>
        <span class="accent wipe">{hero.h1[1]}</span>
      </h1>
      <p class="lead in d5">{o.bajada}</p>
      <div class="btns in d6" style="margin-top:6px">
        <a class="btn btn--light" data-cta="agendar" data-pos="hero" href={CALENDAR_URL} target="_blank" rel="noopener"><svg width="20" height="20" aria-hidden="true"><use href="#i-cal"></use></svg>{hero.agendar}</a>
        <a class="btn btn--outline" data-cta="whatsapp" data-pos="hero" href={waUrl} target="_blank" rel="noopener"><svg width="20" height="20" aria-hidden="true"><use href="#i-chat"></use></svg>{hero.whatsapp}</a>
      </div>
      <div class="micro in d7"><span class="dot" aria-hidden="true"></span>{hero.micro}</div>
    </div>
  </header>

  <div class="ribbon" aria-hidden="true">
    <div class="ribbon__track">
      {
        [0, 1].map(() => (
          <div class="ribbon__group">
            {o.cinta.map((t) => (
              <>
                <span>{t}</span>
                <i />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <main>
    <section class="section" style="background:var(--paper);color:var(--black)">
      <div class="wrap stack">
        <div class="head rv">
          <div class="eyebrow" style="color:var(--blue)">{dolores.eyebrow}</div>
          <h2 class="h2">{dolores.h2}</h2>
        </div>
        <div class="grid3">
          {
            dolores.cards.map(([titulo, texto], i) => (
              <div class="card-light rv">
                <div class="num">{String(i + 1).padStart(2, '0')}</div>
                <h3>{titulo}</h3>
                <p>{texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap stack">
        <div class="head rv">
          <div class="eyebrow" style="color:var(--celeste)">{ordenamos.eyebrow}</div>
          <h2 class="h2">{o.h2}</h2>
        </div>
        <div class="grid3">
          {
            o.cards.map(([icono, titulo, texto]) => (
              <div class="card-dark rv">
                <div class="icon">
                  <svg width="22" height="22" aria-hidden="true"><use href={`#i-${icono}`} /></svg>
                </div>
                <h3>{titulo}</h3>
                <p>{texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--paper);color:var(--black)">
      <div class="wrap stack">
        <div class="rv" style="display:flex;flex-direction:column;gap:14px">
          <div class="tag-dark">{reunion.tag}</div>
          <h2 class="h2">{reunion.h2}</h2>
        </div>
        <ol class="steps grid3">
          {
            reunion.pasos.map(([titulo, texto], i) => (
              <li class="step rv">
                <div class:list={['step__n', { 'step__n--alt': i === 2 }]}>{i + 1}</div>
                <div>
                  <h3>{titulo}</h3>
                  <p>{texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="btn btn--navy rv" data-cta="agendar" data-pos="pasos" href={CALENDAR_URL} target="_blank" rel="noopener">{reunion.cta}<svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"></use></svg></a>
      </div>
    </section>

    <section class="section" style="background:var(--blue)">
      <div class="wrap stack" style="gap:28px">
        <div class="eyebrow rv">{prueba.eyebrow}</div>
        <div class="stats">
          {
            prueba.stats.map(([cifra, texto]) => (
              <div class="stat rv">
                <b>{cifra}</b>
                <span>{texto}</span>
              </div>
            ))
          }
        </div>
        <div class="cases">
          {
            prueba.casos.map((c) => (
              <figure class="case rv">
                <div class="case__tag">{c.tag}</div>
                <blockquote>
                  {c.antes}
                  <strong>{c.destacado}</strong>
                  {c.despues}
                </blockquote>
                <small>{prueba.plazo}</small>
              </figure>
            ))
          }
        </div>
        <p class="case-note rv">{prueba.nota}</p>
      </div>
    </section>

    <section class="section" style="background:var(--white);color:var(--black)">
      <div class="wrap stack" style="max-width:880px;gap:28px">
        <h2 class="h2 rv">{faq.h2}</h2>
        <div class="faq rv">
          {
            faq.items.map(([pregunta, respuesta]) => (
              <details>
                <summary>
                  {pregunta}
                  <span class="plus" aria-hidden="true">+</span>
                </summary>
                <p>{respuesta}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" style="padding:80px 0 88px">
      <div class="wrap rv" style="display:flex;flex-direction:column;gap:20px">
        <h2 class="closing">{cierre.h2} <span>{cierre.h2Accent}</span></h2>
        <p class="lead" style="max-width:500px">{cierre.bajada}</p>
        <div class="btns" style="margin-top:6px">
          <a class="btn btn--light" data-cta="agendar" data-pos="cierre" href={CALENDAR_URL} target="_blank" rel="noopener"><svg width="20" height="20" aria-hidden="true"><use href="#i-cal"></use></svg>{hero.agendar}</a>
          <a class="btn btn--outline" data-cta="whatsapp" data-pos="cierre" href={waUrl} target="_blank" rel="noopener"><svg width="20" height="20" aria-hidden="true"><use href="#i-chat"></use></svg>{hero.whatsapp}</a>
        </div>
        <div class="contact">
          {
            cierre.contacto.map((c) => (
              <a data-cta={c.cta} data-pos="cierre" href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                <span>
                  <svg width="20" height="20" aria-hidden="true"><use href={`#i-${c.icon}`} /></svg>
                  <span>{c.label}</span>
                </span>
                <span class="act">{c.act}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <img src="/agro/logo-fedes.svg" width="180" height="67" alt="Fedes Consultora" style="height:30px;width:auto" />
      <nav aria-label="Legales">
        {footer.legales.map((l) => <a href={l.href}>{l.label}</a>)}
        <small>{footer.copy}</small>
      </nav>
    </div>
  </footer>

  <div class="bar">
    <a class="b1" data-cta="agendar" data-pos="barra" href={CALENDAR_URL} target="_blank" rel="noopener"><svg width="18" height="18" aria-hidden="true"><use href="#i-cal"></use></svg>{barra.agendar}</a>
    <a class="b2" data-cta="whatsapp" data-pos="barra" href={waUrl} target="_blank" rel="noopener"><svg width="18" height="18" aria-hidden="true"><use href="#i-chat"></use></svg>{barra.whatsapp}</a>
  </div>

  <script is:inline define:vars={{ origen: key }}>
    // Medición GA4: un único listener que lee data-cta y data-pos. Sin PUBLIC_GA_ID no hay gtag y no se envía nada.
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-cta]');
      if (!a || typeof window.gtag !== 'function') return;
      window.gtag('event', 'click_' + a.getAttribute('data-cta'), {
        origen: origen,
        ubicacion: a.getAttribute('data-pos') || '',
        link_url: a.href,
      });
    });
  </script>
</Campana>

<style is:global>
  /* Estilos portados del HTML de referencia del brief (landing-campo/index.html), sin cambios de valores.
     Tokens propios de la campaña: --navy, --paper, --muted, --gray y --line no son del manual de marca
     (excepción aprobada, ver docs/10-landing-campo.md). */
  :root {
    --navy: #14303d;
    --blue: #44718d;
    --celeste: #71a0c0;
    --black: #1d1d1b;
    --paper: #f3f1ec;
    --white: #ffffff;
    --muted: #d3e1ea;
    --gray: #4a4a48;
    --line: #e2ded5;
    --radius: 22px;
    --gutter: 24px;
    --maxw: 1160px;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--navy); color: var(--white); font-family: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: clip; }
  img { max-width: 100%; display: block; }
  a { color: var(--celeste); }
  a:hover { color: var(--white); }
  :focus-visible { outline: 2px solid var(--celeste); outline-offset: 3px; }
  h1, h2, h3, p, figure, blockquote, ol { margin: 0; }
  .wrap { width: 100%; max-width: var(--maxw); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .section { padding: 72px 0 80px; }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; }
  .h2 { font-size: clamp(30px, 8vw, 54px); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; text-wrap: balance; }
  .head { display: flex; flex-direction: column; gap: 12px; max-width: 680px; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .stack { display: flex; flex-direction: column; gap: 32px; }

  /* Botones */
  .btns { display: flex; flex-wrap: wrap; gap: 10px; max-width: 540px; }
  .btn { flex: 1 1 220px; min-height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 999px; padding: 0 22px; font-size: 16px; font-weight: 800; text-decoration: none; transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease; }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: scale(0.97); }
  .btn svg { flex-shrink: 0; }
  .btn--light { background: var(--white); color: var(--navy); }
  .btn--light:hover { background: var(--celeste); color: var(--navy); }
  .btn--outline { background: transparent; color: var(--white); border: 1.5px solid rgba(255, 255, 255, 0.9); font-weight: 700; }
  .btn--outline:hover { background: var(--white); color: var(--navy); }
  .btn--navy { flex: 0 0 auto; background: var(--navy); color: var(--white); padding: 0 26px; align-self: flex-start; }
  .btn--navy:hover { background: var(--blue); color: var(--white); }

  /* Hero */
  .hero { position: relative; min-height: 800px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
  .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 74% 24%; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20, 48, 61, 0.62) 0%, rgba(20, 48, 61, 0) 20%, rgba(20, 48, 61, 0) 32%, rgba(20, 48, 61, 0.55) 44%, rgba(20, 48, 61, 0.94) 56%, var(--navy) 66%); }
  .hero__top { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 22px; padding-bottom: 22px; }
  .hero__logo { height: 36px; width: auto; }
  .pill { border: 1px solid rgba(255, 255, 255, 0.8); border-radius: 999px; padding: 8px 14px; font-size: 10px; font-weight: 700; letter-spacing: 2.2px; background: rgba(20, 48, 61, 0.45); white-space: nowrap; }
  .hero__body { position: relative; display: flex; flex-direction: column; gap: 18px; padding-bottom: 36px; }
  .origin { align-self: flex-start; display: flex; align-items: center; gap: 8px; border: 1px solid rgba(113, 160, 192, 0.7); border-radius: 999px; padding: 7px 13px; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--celeste); background: rgba(20, 48, 61, 0.6); }
  .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--celeste); flex-shrink: 0; }
  .h1 { font-size: clamp(44px, 11.5vw, 104px); font-weight: 800; line-height: 0.98; letter-spacing: -0.035em; max-width: 880px; }
  .h1 span { display: block; }
  .h1 .accent { color: var(--celeste); }
  .lead { font-size: 17px; line-height: 1.55; color: var(--muted); max-width: 540px; }
  .micro { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; max-width: 540px; font-size: 12px; font-weight: 700; letter-spacing: 1.8px; color: var(--muted); }
  .micro .dot { width: 8px; height: 8px; }

  /* Cinta */
  .ribbon { background: var(--celeste); color: var(--navy); overflow: hidden; padding: 14px 0; }
  .ribbon__track { display: flex; width: max-content; }
  .ribbon__group { display: flex; align-items: center; gap: 24px; padding-right: 24px; font-size: 12px; font-weight: 800; letter-spacing: 3px; white-space: nowrap; }
  .ribbon__group i { width: 5px; height: 5px; border-radius: 999px; background: var(--navy); }

  /* Tarjetas */
  .card-light { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 10px; color: var(--black); }
  .card-light .num { font-size: 13px; font-weight: 800; letter-spacing: 2px; color: var(--blue); }
  .card-light h3 { font-size: 20px; font-weight: 800; line-height: 1.25; }
  .card-light p { font-size: 16px; line-height: 1.5; color: var(--gray); }
  .card-dark { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .card-dark h3 { font-size: 21px; font-weight: 800; line-height: 1.2; letter-spacing: -0.01em; }
  .card-dark p { font-size: 16px; line-height: 1.55; color: var(--muted); }
  .icon { width: 48px; height: 48px; border-radius: 999px; background: var(--celeste); color: var(--navy); display: flex; align-items: center; justify-content: center; margin-bottom: 4px; }

  /* Pasos */
  .steps { list-style: none; padding: 0; }
  .step { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; display: flex; gap: 16px; align-items: flex-start; color: var(--black); }
  .step__n { flex-shrink: 0; width: 44px; height: 44px; border-radius: 999px; background: var(--navy); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; }
  .step__n--alt { background: var(--blue); }
  .step h3 { font-size: 19px; font-weight: 800; line-height: 1.25; }
  .step p { font-size: 16px; line-height: 1.5; color: var(--gray); margin-top: 4px; }
  .tag-dark { align-self: flex-start; background: var(--navy); color: var(--white); border-radius: 999px; padding: 7px 14px; font-size: 11px; font-weight: 700; letter-spacing: 2.2px; }

  /* Prueba */
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .stat { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid rgba(255, 255, 255, 0.55); padding-top: 16px; }
  .stat b { font-size: clamp(56px, 15vw, 88px); font-weight: 900; line-height: 0.95; letter-spacing: -0.04em; }
  .stat span { font-size: 15px; font-weight: 500; line-height: 1.45; }
  .case { background: var(--white); color: var(--black); border-radius: var(--radius); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .case__tag { font-size: 11px; font-weight: 700; letter-spacing: 2px; line-height: 1.5; color: var(--blue); }
  .case blockquote { font-size: 18px; font-weight: 500; line-height: 1.5; }
  .case strong { font-weight: 900; color: var(--navy); }
  .case small { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); font-size: 13px; line-height: 1.5; color: var(--gray); }
  .cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
  .case-note { margin-top: -12px; font-size: 13px; line-height: 1.5; color: var(--white); }

  /* Preguntas frecuentes */
  .faq { border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; min-height: 44px; font-size: 18px; font-weight: 700; line-height: 1.3; }
  .faq summary::-webkit-details-marker { display: none; }
