  .bar { position: sticky; bottom: 0; z-index: 10; background: rgba(20, 48, 61, 0.95); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-top: 1px solid rgba(255, 255, 255, 0.14); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; gap: 8px; }
  .bar a { flex: 1 1 0; min-height: 50px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 999px; font-size: 15px; font-weight: 800; text-decoration: none; }
  .bar .b1 { background: var(--white); color: var(--navy); }
  .bar .b2 { background: var(--celeste); color: var(--navy); }
  @media (min-width: 900px) { .bar { display: none; } }

  /* Animaciones */
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes kb { from { transform: scale(1.12); } to { transform: scale(1); } }
  @keyframes wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes mq { to { transform: translateX(-50%); } }
  @keyframes ring { 0% { box-shadow: 0 0 0 0 rgba(113, 160, 192, 0.6); } 70% { box-shadow: 0 0 0 14px rgba(113, 160, 192, 0); } 100% { box-shadow: 0 0 0 0 rgba(113, 160, 192, 0); } }
  @keyframes barin { from { opacity: 0; transform: translateY(120%); visibility: hidden; } to { opacity: 1; transform: none; visibility: visible; } }
  .hero__img { animation: kb 3s var(--ease) both; }
  .in { animation: rise 0.9s var(--ease) both; }
  .d0 { animation-delay: 0.05s; }
