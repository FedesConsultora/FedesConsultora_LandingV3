  .d7 { animation-delay: 1.25s; }
  .wipe { animation: wipe 1s cubic-bezier(0.7, 0, 0.2, 1) 0.5s both; }
  .ribbon__track { animation: mq 26s linear infinite; }
  .bar .b2 { animation: ring 2.4s ease-out infinite; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>

<!-- Animaciones al hacer scroll. Van sin procesar (is:inline): al compilar, Lightning CSS mete
     animation-timeline dentro del shorthand animation y Chrome descarta la regla entera. -->
<style is:inline>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rv { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% cover 25%; }
      .bar { animation: barin linear both; animation-timeline: scroll(root); animation-range: 520px 700px; }
    }
  }
</style>
