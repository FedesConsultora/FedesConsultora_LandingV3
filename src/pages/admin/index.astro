---
// Inicio del panel: lo que requiere acción hoy, y abajo un resumen con números.
export const prerender = false;
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { db, hasDb } from '../../lib/db';
import { descartarAvisoSinVisitas, pendientes } from '../../lib/pendientes';

const TZ = 'America/Argentina/Buenos_Aires';
const csrf = Astro.locals.admin!.csrf;

// Descartar el aviso de una landing sin visitas. El middleware ya validó sesión y CSRF.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const landingId = Number(form.get('landing_id'));
  if (form.get('accion') === 'descartar_aviso' && Number.isInteger(landingId)) {
    await descartarAvisoSinVisitas(landingId, Astro.locals.admin!.id);
  }
  return Astro.redirect('/admin', 303);
}

let p: Awaited<ReturnType<typeof pendientes>> | null = null;
let resumen = { total: 0, semana: 0, mes: 0, fallos: 0, porDia: [] as { dia: string; n: number }[], porResolver: [] as { resolver: string; n: number }[] };
let dbError: string | null = null;

if (hasDb()) {
  try {
    const [pend, [tot], porDia, porResolver] = await Promise.all([
      pendientes(),
      db()`
        SELECT count(*)::int AS total,
               count(*) FILTER (WHERE created_at > now() - interval '7 days')::int AS semana,
               count(*) FILTER (WHERE created_at > now() - interval '30 days')::int AS mes,
               (SELECT count(*)::int FROM formularios WHERE resend_status = 'failed') AS fallos
        FROM leads
      `,
      db()`
        SELECT (created_at AT TIME ZONE ${TZ})::date::text AS dia, count(*)::int AS n
        FROM leads WHERE created_at > now() - interval '14 days' GROUP BY 1
      `,
      db()`SELECT resolver, count(*)::int AS n FROM leads WHERE resolver IS NOT NULL GROUP BY 1 ORDER BY 2 DESC`,
    ]);
    p = pend;
    resumen = { ...(tot as typeof resumen), porDia: porDia as typeof resumen.porDia, porResolver: porResolver as typeof resumen.porResolver };
  } catch (e) {
    console.error('[admin] Error de conexión a la base', e);
    dbError = 'No pudimos conectar con la base de datos. Revisá que las migraciones estén aplicadas (npm run db:migrate).';
  }
} else {
  dbError = 'Todavía no hay una base de datos conectada (falta POSTGRES_URL).';
}

const diaAR = (d: Date | number) => new Date(d).toLocaleDateString('en-CA', { timeZone: TZ });
const hoy = diaAR(Date.now());
const fechaHora = (d: Date) =>
  new Date(d).toLocaleString('es-AR', { timeZone: TZ, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const fechaCorta = (iso: string) => iso.split('-').reverse().slice(0, 2).join('/');
const haceDias = (d: Date) => {
  const dias = Math.floor((Date.now() - new Date(d).getTime()) / 86400000);
  return dias === 0 ? 'hoy' : dias === 1 ? 'ayer' : `hace ${dias} días`;
};

// Últimos 14 días para el gráfico de barras.
const dias = Array.from({ length: 14 }, (_, i) => {
  const d = Date.now() - (13 - i) * 86400000;
  const key = diaAR(d);
  return { key, n: resumen.porDia.find((x) => x.dia === key)?.n ?? 0, label: new Date(d).toLocaleDateString('es-AR', { timeZone: TZ, day: '2-digit', month: '2-digit' }) };
});
const maxDia = Math.max(1, ...dias.map((d) => d.n));
const maxResolver = Math.max(1, ...resumen.porResolver.map((r) => r.n));

const secciones = p
  ? [p.pasos.length, p.sinMarcar.length, p.proximas.length, p.nuevosWeb.length, p.enArmado.length, p.sinVisitas.length]
  : [];
const totalPendientes = secciones.reduce((a, b) => a + b, 0);
---

<AdminLayout title="Inicio">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold md:text-3xl">Pendientes</h1>
      <p class="mt-1 text-ink/60">
        {
          new Date().toLocaleDateString('es-AR', { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long' }).replace(/^./, (c) => c.toUpperCase())
        }
      </p>
    </div>
    <div class="flex gap-2">
      <a href="/admin/leads" class="btn btn-outline-dark !py-2.5">Ver pipeline</a>
      <a href="/admin/leads/nuevo" class="btn btn-primary !py-2.5">Nuevo lead</a>
    </div>
  </div>

  {
    dbError && (
      <p class="mt-6 rounded-xl px-5 py-4 text-sm" style="border:1px solid #8f5f16; color:#8f5f16; background:#faf0da">
        {dbError}
      </p>
    )
  }

  {
    p && totalPendientes === 0 && (
      <p class="admin-card mt-8 text-ink/60">No hay nada pendiente. Los próximos pasos, las sesiones y las landings por entregar van a aparecer acá.</p>
    )
  }

  {
    p && totalPendientes > 0 && (
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {p.pasos.length > 0 && (
          <section class="admin-card">
            <h2 class="eyebrow text-ink/50">Próximos pasos de hoy y vencidos · {p.pasos.length}</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {p.pasos.map((l) => (
                <li class="flex items-start justify-between gap-4 py-3">
                  <div>
                    <a href={`/admin/leads/${l.id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                    <p class="text-sm text-ink/70">{l.proximo_paso ?? 'Sin descripción'}</p>
                  </div>
                  <span class:list={['admin-tag shrink-0', l.fecha < hoy && '!bg-[#fbeae3] !text-[#a8412b]']}>
                    {l.fecha < hoy ? `Vencido ${fechaCorta(l.fecha)}` : 'Hoy'}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {p.sinMarcar.length > 0 && (
          <section class="admin-card">
            <h2 class="eyebrow text-ink/50">Sesiones pasadas sin marcar como realizadas · {p.sinMarcar.length}</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {p.sinMarcar.map((l) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <div>
                    <a href={`/admin/leads/${l.id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                    <p class="text-sm text-ink/60">{fechaHora(l.fecha_sesion)}</p>
                  </div>
                  <form method="post" action={`/admin/leads/${l.id}`}>
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="accion" value="estado" />
                    <input type="hidden" name="estado" value="sesion_realizada" />
                    <button class="btn btn-outline-dark !px-4 !py-1.5 !text-xs">Marcar realizada</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        )}

        {p.proximas.length > 0 && (
          <section class="admin-card">
            <h2 class="eyebrow text-ink/50">Sesiones de los próximos 7 días · {p.proximas.length}</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {p.proximas.map((l) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <div>
                    <a href={`/admin/leads/${l.id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                    <p class="text-sm text-ink/60">{l.nombre}</p>
                  </div>
                  <span class="admin-tag shrink-0">{fechaHora(l.fecha_sesion)}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {p.nuevosWeb.length > 0 && (
          <section class="admin-card">
            <h2 class="eyebrow text-ink/50">Nuevos del formulario web, sin tocar · {p.nuevosWeb.length}</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {p.nuevosWeb.map((l) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <div>
                    <a href={`/admin/leads/${l.id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                    <p class="text-sm text-ink/60">{[l.nombre, l.resolver].filter(Boolean).join(' · ')}</p>
                  </div>
                  <span class="admin-tag shrink-0">{haceDias(l.created_at)}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {p.enArmado.length > 0 && (
          <section class="admin-card">
            <h2 class="eyebrow text-ink/50">Landings en armado · {p.enArmado.length}</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {p.enArmado.map((l) => {
                const lista = l.al_entregar > 0 && l.al_entregar_sin_aprobar === 0;
                return (
                  <li class="flex items-center justify-between gap-4 py-3">
                    <div>
                      <a href={`/admin/landings/${l.id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                      <p class="text-sm text-ink/60">
                        {l.aprobadas} de {l.etapas} etapas aprobadas
                      </p>
                    </div>
                    <span class:list={['admin-tag shrink-0', lista && '!bg-azul !text-white']}>{lista ? 'Lista para entregar' : 'Por aprobar'}</span>
                  </li>
                );
              })}
            </ul>
          </section>
        )}

        {p.sinVisitas.length > 0 && (
          <section class="admin-card">
            <h2 class="eyebrow text-ink/50">Landings entregadas sin visitas · {p.sinVisitas.length}</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {p.sinVisitas.map((l) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <div>
                    <a href={`/admin/leads/${l.lead_id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                    <p class="text-sm text-ink/60">Entregada {haceDias(l.entregada_el)}</p>
                  </div>
                  <form method="post">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="landing_id" value={l.id} />
                    <button name="accion" value="descartar_aviso" class="btn btn-outline-dark !px-4 !py-1.5 !text-xs">Descartar aviso</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )
  }

  <!-- Resumen -->
  <h2 class="mt-12 text-lg font-semibold">Resumen</h2>
  <div class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10 md:grid-cols-4">
    <div class="bg-white p-5"><p class="eyebrow text-ink/50">Leads</p><p class="mt-1 font-display text-2xl font-extrabold text-azul">{resumen.total}</p></div>
    <div class="bg-white p-5"><p class="eyebrow text-ink/50">Nuevos, 7 días</p><p class="mt-1 font-display text-2xl font-extrabold text-azul">{resumen.semana}</p></div>
    <div class="bg-white p-5"><p class="eyebrow text-ink/50">Nuevos, 30 días</p><p class="mt-1 font-display text-2xl font-extrabold text-azul">{resumen.mes}</p></div>
    <div class="bg-white p-5">
      <p class="eyebrow text-ink/50">Fallos del aviso por mail</p>
      <p class:list={['mt-1 font-display text-2xl font-extrabold', resumen.fallos > 0 ? 'text-[#a8412b]' : 'text-azul']}>{resumen.fallos}</p>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
    <div class="admin-card">
      <p class="eyebrow text-ink/50">Leads nuevos por día, últimos 14 días</p>
      <div class="mt-5 flex h-24 items-end gap-2">
        {
          dias.map((d) => (
            <div class="flex min-w-0 flex-1 flex-col items-center gap-2" title={`${d.label}: ${d.n}`}>
              <div class="w-full rounded-t bg-azul" style={`height:${Math.max(4, (d.n / maxDia) * 72)}px`} />
              <span class="hidden font-mono text-[10px] text-ink/40 sm:block">{d.label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="admin-card">
      <p class="eyebrow text-ink/50">Qué quieren resolver</p>
      <div class="mt-5 space-y-3">
        {resumen.porResolver.length === 0 && <p class="text-sm text-ink/50">Todavía no hay datos.</p>}
        {
          resumen.porResolver.map((r) => (
            <div>
              <div class="flex justify-between text-sm"><span>{r.resolver}</span><span class="font-semibold">{r.n}</span></div>
              <div class="mt-1 h-2 rounded-full bg-ink/10">
                <div class="h-2 rounded-full bg-celeste" style={`width:${(r.n / maxResolver) * 100}%`} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</AdminLayout>
