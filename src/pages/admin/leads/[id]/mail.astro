---
// Redactar un mail a un lead: desde una plantilla, en blanco o respondiendo un mail recibido.
// "Vista previa" muestra el mail exacto; "Enviar" pasa por las mismas reglas de siempre (enviarMail).
export const prerender = false;
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { dejarAviso } from '../../../../lib/flash';
import { MailError, enviarMail, listarPlantillas, modoMails, vistaPrevia } from '../../../../lib/mails';
import { VARIABLES, motivoNoEnviable, tienePendientes } from '../../../../lib/mails-core';
import { db } from '../../../../lib/db';

const id = Number(Astro.params.id);
const adminId = Astro.locals.admin!.id;
const csrf = Astro.locals.admin!.csrf;
const params = Astro.url.searchParams;

const [lead] = Number.isInteger(id)
  ? await db()`SELECT id, nombre, empresa, email, consentimiento_el, baja_el, rebote_el FROM leads WHERE id = ${id}`
  : [];
if (!lead) return Astro.redirect('/admin/leads', 303);

const plantillas = await listarPlantillas();
const respondeA = Number(params.get('responde')) || null;
const [original] = respondeA ? await db()`SELECT id, asunto, cuerpo, recibido_el FROM mensajes_recibidos WHERE id = ${respondeA} AND lead_id = ${id}` : [];
const plantilla = plantillas.find((p) => p.id === Number(params.get('plantilla')));

let asunto = plantilla?.asunto ?? (original ? (/^re:/i.test(original.asunto) ? original.asunto : `Re: ${original.asunto}`) : '');
let cuerpo = plantilla?.cuerpo ?? (original ? 'Hola, {{nombre}}:\n\n' : '');
let previa: { asunto: string; html: string; para: string } | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  asunto = String(form.get('asunto') ?? '');
  cuerpo = String(form.get('cuerpo') ?? '').replace(/\r\n/g, '\n');
  const plantillaId = Number(form.get('plantilla_id')) || null;
  const responde = Number(form.get('responde')) || null;
  try {
    if (form.get('accion') === 'previa') {
      previa = await vistaPrevia({ leadId: id, asunto, cuerpo });
    } else if (form.get('accion') === 'enviar') {
      const r = await enviarMail({ leadId: id, asunto, cuerpo, tipo: responde ? 'respuesta' : 'manual', plantillaId, respondeA: responde, adminId });
      dejarAviso(Astro.cookies, r.estado === 'enviado' ? 'Mail enviado.' : (r.motivo ?? 'El mail no salió.'), r.estado !== 'enviado');
      return Astro.redirect(`/admin/leads/${id}#mails`, 303);
    }
  } catch (e) {
    if (!(e instanceof MailError)) throw e;
    error = e.message;
  }
}

const bloqueo = motivoNoEnviable(lead as never);
const modo = modoMails();
const saldraSimulado = !modo.real || modo.pieConPendientes || tienePendientes(asunto, cuerpo) || (modo.permitidos.length > 0 && !modo.permitidos.includes(String(lead.email).toLowerCase()));
---

<AdminLayout title={`Mail a ${lead.empresa}`}>
  <a href={`/admin/leads/${id}`} class="font-display text-sm text-ink/50 hover:text-azul">← {lead.empresa}</a>
  <h1 class="mt-3 font-display text-2xl font-bold text-ink md:text-3xl">{original ? 'Responder' : 'Nuevo mail'}</h1>
  <p class="mt-1 font-display text-sm text-ink/60">Para {lead.nombre}{lead.email ? ` · ${lead.email}` : ''}</p>

  {bloqueo && <p class="mt-5 rounded-xl border border-[#a8412b]/40 bg-[#fbeae3] px-5 py-3 text-sm text-[#a8412b]" role="alert">No se le puede escribir: {bloqueo}</p>}
  {error && <p class="mt-5 rounded-xl border border-[#a8412b]/40 bg-[#fbeae3] px-5 py-3 text-sm text-[#a8412b]" role="alert">{error}</p>}
  {!bloqueo && saldraSimulado && (
    <p class="mt-5 rounded-xl border border-[#8f5f16]/30 bg-[#faf0da] px-5 py-3 font-display text-sm text-[#8f5f16]">
      Este mail no va a salir de verdad: {!modo.real ? 'falta la clave de Resend' : modo.pieConPendientes || tienePendientes(asunto, cuerpo) ? 'hay textos [PENDIENTE]' : 'el destinatario no está en la lista de prueba'}. Queda registrado como simulado.
    </p>
  )}

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <form method="post" class="admin-card space-y-4">
      <input type="hidden" name="csrf" value={csrf} />
      {plantilla && <input type="hidden" name="plantilla_id" value={plantilla.id} />}
      {original && <input type="hidden" name="responde" value={original.id} />}
      {!original && (
        <div>
          <p class="admin-label">Partir de una plantilla</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {plantillas.map((p) => (
              <a href={`/admin/leads/${id}/mail?plantilla=${p.id}`} class:list={['admin-tag !px-3 !py-1.5', plantilla?.id === p.id && '!bg-ink !text-white']}>
                {p.nombre}
              </a>
            ))}
            <a href={`/admin/leads/${id}/mail`} class:list={['admin-tag !px-3 !py-1.5', !plantilla && '!bg-ink !text-white']}>En blanco</a>
          </div>
        </div>
      )}
      <div>
        <label for="asunto" class="admin-label">Asunto</label>
        <input id="asunto" name="asunto" value={asunto} maxlength="200" class="admin-input" />
      </div>
      <div>
        <label for="cuerpo" class="admin-label">Texto</label>
        <textarea id="cuerpo" name="cuerpo" rows="12" maxlength="10000" class="admin-input leading-relaxed">{cuerpo}</textarea>
        <p class="mt-2 font-display text-xs text-ink/55">
          Variables: {VARIABLES.map((v) => `{{${v}}}`).join(', ')}. Sin emojis ni precios. El pie legal y el link de baja se agregan solos.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button name="accion" value="previa" class="btn btn-outline-dark !py-2">Vista previa</button>
        <button name="accion" value="enviar" class="btn btn-primary !py-2" disabled={Boolean(bloqueo)}>Enviar</button>
      </div>
    </form>

    <div class="space-y-6">
      {previa && (
        <section class="admin-card">
          <p class="admin-label">Vista previa · para {previa.para}</p>
          <p class="mt-2 font-display text-sm font-semibold text-ink">{previa.asunto}</p>
          <iframe title="Vista previa del mail" sandbox="" srcdoc={previa.html} class="mt-3 h-[460px] w-full rounded-xl border border-ink/10 bg-[#F4F6F7]"></iframe>
        </section>
      )}
      {original && (
        <section class="admin-card">
          <p class="admin-label">Mail que estás respondiendo</p>
          <p class="mt-2 font-display text-sm font-semibold text-ink">{original.asunto}</p>
          <p class="mt-3 max-h-[320px] overflow-y-auto whitespace-pre-line text-sm text-ink/70">{original.cuerpo}</p>
        </section>
      )}
    </div>
  </div>
</AdminLayout>
