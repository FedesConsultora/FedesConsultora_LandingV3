---
export const prerender = false;
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { db, hasDb } from '../../../lib/db';
import { contarPorEstado, listarLeads, type LeadFila } from '../../../lib/leads';
import { ESTADOS, FUENTES, TAMANOS, etiqueta, fechaISO } from '../../../lib/pipeline';

const filtro = ESTADOS.some((e) => e.codigo === Astro.url.searchParams.get('estado'))
  ? Astro.url.searchParams.get('estado')!
  : undefined;

let todos: LeadFila[] = [];
let leads: LeadFila[] = [];
let porEstado: Record<string, number> = {};
let fallosAviso = 0;
let dbError: string | null = null;

if (hasDb()) {
  try {
    [todos, porEstado, [{ n: fallosAviso }]] = await Promise.all([
      listarLeads(),
      contarPorEstado(),
      db()`SELECT count(*)::int AS n FROM formularios WHERE resend_status = 'failed'`,
    ]);
    leads = filtro ? todos.filter((l) => l.estado === filtro) : todos;
  } catch (e) {
    console.error('[admin] Error de conexión a la base', e);
    dbError = 'No pudimos conectar con la base de datos. Revisá que las migraciones estén aplicadas (npm run db:migrate).';
  }
} else {
  dbError = 'Todavía no hay una base de datos conectada (falta POSTGRES_URL).';
}

const now = Date.now();
const day = 24 * 60 * 60 * 1000;
const inLast = (d: Date, ms: number) => now - new Date(d).getTime() < ms;

const leadsWeek = todos.filter((l) => inLast(l.created_at, 7 * day)).length;
const leadsMonth = todos.filter((l) => inLast(l.created_at, 30 * day)).length;

const porResolver = Object.entries(
  todos.reduce<Record<string, number>>((acc, l) => {
    if (l.resolver) acc[l.resolver] = (acc[l.resolver] ?? 0) + 1;
    return acc;
  }, {}),
).sort((a, b) => b[1] - a[1]);
const maxResolver = Math.max(1, ...porResolver.map(([, n]) => n));

// Fecha AAAA-MM-DD en hora de Buenos Aires (el servidor corre en UTC).
const TZ = 'America/Argentina/Buenos_Aires';
const diaAR = (d: Date | number) => new Date(d).toLocaleDateString('en-CA', { timeZone: TZ });

// Últimos 14 días, para el mini gráfico de barras (leads nuevos por día).
const days = Array.from({ length: 14 }, (_, i) => {
  const d = new Date(now - (13 - i) * day);
  const key = diaAR(d);
  const count = todos.filter((l) => diaAR(l.created_at) === key).length;
  return { key, count, label: d.toLocaleDateString('es-AR', { timeZone: TZ, day: '2-digit', month: '2-digit' }) };
});
const maxDay = Math.max(1, ...days.map((d) => d.count));

const hoy = diaAR(now);
const fecha = (d: Date) => new Date(d).toLocaleDateString('es-AR', { timeZone: TZ });

// Para la descarga en CSV: los leads de la vista actual, con etiquetas legibles.
const csvRows = leads.map((l) => ({
  creado: new Date(l.created_at).toISOString(),
  empresa: l.empresa,
  nombre: l.nombre,
  cargo: l.cargo,
  email: l.email,
  whatsapp: l.whatsapp,
  linkedin: l.linkedin_url,
  sitio_web: l.sitio_web,
  pais: l.pais,
  ciudad: l.ciudad,
  sector: l.sector,
  tamano: etiqueta(TAMANOS, l.tamano),
  fuente: etiqueta(FUENTES, l.fuente),
  estado: etiqueta(ESTADOS, l.estado),
  resolver: l.resolver,
  proximo_paso: l.proximo_paso,
  fecha_proximo_paso: fechaISO(l.fecha_proximo_paso),
}));
---

<AdminLayout title="Leads">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="text-2xl font-bold md:text-3xl">Leads</h1>
    <a href="/admin/leads/nuevo" class="btn btn-primary !py-2.5">Nuevo lead</a>
  </div>

  {
    dbError && (
      <p class="mt-6 rounded-xl px-5 py-4 text-sm" style="border:1px solid #8f5f16; color:#8f5f16; background:#faf0da">
        {dbError}
      </p>
    )
  }

  <!-- Pipeline -->
  <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
    <h2 class="text-lg font-semibold">Pipeline</h2>
    <button id="export-csv" type="button" class="btn btn-outline-dark !py-2 !text-xs">Descargar CSV</button>
  </div>

  <nav class="mt-4 flex flex-wrap gap-2" aria-label="Filtrar por estado">
    <a href="/admin/leads" class:list={['admin-tag', !filtro && '!bg-ink !text-white']}>Todos · {todos.length}</a>
    {
      ESTADOS.map((e) => (
        <a href={`/admin/leads?estado=${e.codigo}`} class:list={['admin-tag', filtro === e.codigo && '!bg-ink !text-white']}>
          {e.etiqueta} · {porEstado[e.codigo] ?? 0}
        </a>
      ))
    }
  </nav>

  <div class="mt-4 overflow-x-auto rounded-2xl border border-ink/10 bg-white">
    <table class="w-full min-w-[860px] border-collapse text-sm">
      <thead>
        <tr class="border-b border-ink/10 bg-ink/[0.03] text-left font-display text-[11px] font-semibold uppercase tracking-wide text-ink/50">
          <th class="p-3">Empresa</th>
          <th class="p-3">Contacto</th>
          <th class="p-3">Estado</th>
          <th class="p-3">Fuente</th>
          <th class="p-3">Próximo paso</th>
          <th class="p-3">Actualizado</th>
        </tr>
      </thead>
      <tbody>
        {
          leads.map((l) => {
            const fechaPaso = fechaISO(l.fecha_proximo_paso);
            const vencido = fechaPaso && fechaPaso < hoy;
            return (
              <tr class="border-b border-ink/5 align-top hover:bg-ink/[0.02]">
                <td class="p-3">
                  <a href={`/admin/leads/${l.id}`} class="font-semibold text-azul hover:underline">{l.empresa}</a>
                  {l.sector && <span class="block text-xs text-ink/50">{l.sector}</span>}
                </td>
                <td class="p-3">
                  {l.nombre}
                  {l.cargo && <span class="block text-xs text-ink/50">{l.cargo}</span>}
                </td>
                <td class="p-3"><span class="admin-tag">{etiqueta(ESTADOS, l.estado)}</span></td>
                <td class="p-3 text-ink/70">{etiqueta(FUENTES, l.fuente)}</td>
                <td class="p-3">
                  {l.proximo_paso ?? '—'}
                  {fechaPaso && (
                    <span class:list={['block text-xs', vencido ? 'font-semibold text-[#a8412b]' : 'text-ink/50']}>
                      {vencido ? 'Vencido: ' : ''}{fechaPaso.split('-').reverse().join('/')}
                    </span>
                  )}
                </td>
                <td class="whitespace-nowrap p-3 text-ink/60">{fecha(l.actualizado_el)}</td>
              </tr>
            );
          })
        }
        {
          leads.length === 0 && !dbError && (
            <tr><td colspan="6" class="p-8 text-center text-ink/50">No hay leads{filtro ? ' en este estado' : ''}.</td></tr>
          )
        }
      </tbody>
    </table>
  </div>

  <!-- "<" escapado: los datos vienen del formulario público y no deben poder cerrar esta etiqueta. -->
  <script type="application/json" id="leads-data" set:html={JSON.stringify(csvRows).replace(/</g, '\\u003c')} />
  <script>
    document.getElementById('export-csv')?.addEventListener('click', () => {
      const data: Record<string, unknown>[] = JSON.parse(document.getElementById('leads-data')?.textContent || '[]');
      if (data.length === 0) return;
      const cols = Object.keys(data[0]);
      const esc = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const csv = [cols.join(','), ...data.map((row) => cols.map((c) => esc(row[c])).join(','))].join('\n');
      const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `leads-fedes-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>
</AdminLayout>
