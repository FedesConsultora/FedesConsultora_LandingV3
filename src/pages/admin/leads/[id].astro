---
export const prerender = false;
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import LeadForm from '../../../components/admin/LeadForm.astro';
import { LeadError, actualizarLead, agendarSesion, cambiarEstado, listarSectores, obtenerLead } from '../../../lib/leads';
import { ESTADOS, FUENTES, MOTIVOS_PERDIDO, etiqueta, fechaHoraArgentina, parseCambioEstado, parseLead, type Errores } from '../../../lib/pipeline';
import { ETIQUETA_ESTADO_LANDING, LandingError, activarLanding, crearLanding, estadoVisible, listarLandingsDeLead, resumenLandingDeLead } from '../../../lib/landings';
import { seguimiento } from '../../../lib/proceso';
import SeguimientoLead from '../../../components/admin/SeguimientoLead.astro';

const id = Number(Astro.params.id);
const adminId = Astro.locals.admin!.id;
const csrf = Astro.locals.admin!.csrf;
const sectores = await listarSectores();

let valoresForm: Record<string, unknown> | null = null;
let errores: Errores = {};
let error: string | null = null;

// El middleware ya validó la sesión y el token CSRF de este POST.
if (Astro.request.method === 'POST' && Number.isInteger(id)) {
  const form = await Astro.request.formData();
  const accion = form.get('accion');
  try {
    if (accion === 'guardar') {
      const parsed = parseLead(form, new Set(sectores.map((s) => s.id)));
      errores = parsed.errores;
      if (parsed.data) {
        await actualizarLead(id, parsed.data, adminId);
        return Astro.redirect(`/admin/leads/${id}?guardado=1`, 303);
      }
      valoresForm = Object.fromEntries(form);
    } else if (accion === 'agendar') {
      const fecha = fechaHoraArgentina(String(form.get('fecha_sesion') ?? ''));
      if (!fecha) error = 'Elegí la fecha y la hora de la sesión.';
      else {
        await agendarSesion(id, fecha, adminId);
        return Astro.redirect(`/admin/leads/${id}?agendada=1`, 303);
      }
    } else if (accion === 'entregar_landing') {
      const landingId = Number(form.get('landing_id'));
      // La landing tiene que ser de este lead.
      if (!(await listarLandingsDeLead(id)).some((l) => l.id === landingId)) throw new LandingError('La landing no es de este lead.');
      await activarLanding(landingId, adminId);
      return Astro.redirect(`/admin/leads/${id}?entregada=1`, 303);
    } else if (accion === 'crear_landing') {
      const landingId = await crearLanding(id, adminId);
      return Astro.redirect(`/admin/landings/${landingId}`, 303);
    } else if (accion === 'estado') {
      const cambio = parseCambioEstado(form);
      if (cambio.error) error = cambio.error;
      else {
        await cambiarEstado(id, cambio.estado!, cambio.motivo ?? null, adminId);
        return Astro.redirect(`/admin/leads/${id}?estado=1`, 303);
      }
    }
  } catch (e) {
    if (!(e instanceof LeadError) && !(e instanceof LandingError)) throw e;
    error = e.message;
    if (accion === 'guardar') valoresForm = Object.fromEntries(form);
  }
}

const datos = Number.isInteger(id) ? await obtenerLead(id) : null;
if (!datos) Astro.response.status = 404;
const [landings, resumenLanding] = datos ? await Promise.all([listarLandingsDeLead(id), resumenLandingDeLead(id)]) : [[], null];
const seg = datos ? seguimiento(datos.lead, resumenLanding) : null;

const aviso = Astro.url.searchParams.has('creado')
  ? 'Lead creado.'
  : Astro.url.searchParams.has('guardado')
    ? 'Cambios guardados.'
    : Astro.url.searchParams.has('estado')
      ? 'Estado actualizado.'
      : Astro.url.searchParams.has('agendada')
        ? 'Fecha de la sesión guardada.'
        : Astro.url.searchParams.has('entregada')
          ? 'Landing entregada: el lead ya puede abrir el link.'
          : null;

const fechaHora = (d: Date | string | null) =>
  d
    ? new Date(d).toLocaleString('es-AR', {
        timeZone: 'America/Argentina/Buenos_Aires',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    : '—';
const envioMail: Record<string, string> = { sent: 'aviso enviado', failed: 'falló el aviso', skipped: 'sin aviso' };
---

<AdminLayout title={datos ? datos.lead.empresa : 'Lead no encontrado'}>
  <a href="/admin" class="font-display text-sm text-ink/50 hover:text-azul">← Leads</a>

  {
    !datos ? (
      <h1 class="mt-3 text-2xl font-bold">Este lead no existe.</h1>
    ) : (
      <>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold md:text-3xl">{datos.lead.empresa}</h1>
          <span class="admin-tag">{etiqueta(ESTADOS, datos.lead.estado)}</span>
        </div>
        <p class="mt-1 text-ink/60">
          {datos.lead.nombre}
          {datos.lead.cargo && ` · ${datos.lead.cargo}`} · {etiqueta(FUENTES, datos.lead.fuente)}
        </p>

        {aviso && <p class="mt-6 rounded-xl border border-azul/30 bg-azul/[0.06] px-5 py-3 text-sm text-azul">{aviso}</p>}
        {error && <p class="mt-6 rounded-xl border border-[#a8412b]/40 bg-[#fbeae3] px-5 py-3 text-sm text-[#a8412b]">{error}</p>}
        {seg && <SeguimientoLead seguimiento={seg} fechaSesion={datos.lead.fecha_sesion} />}
        {Object.keys(errores).length > 0 && (
          <p class="mt-6 rounded-xl border border-[#a8412b]/40 bg-[#fbeae3] px-5 py-3 text-sm text-[#a8412b]">Revisá los campos marcados.</p>
        )}

        <div class="mt-8 grid items-start gap-6 lg:grid-cols-[1.6fr_1fr]">
          <div class="admin-card">
            <LeadForm valores={valoresForm ?? datos.lead} sectores={sectores} errores={errores} submit="Guardar cambios" />
          </div>

          <div class="space-y-6">
            <section class="admin-card">
              <h2 class="eyebrow text-ink/50">Landings</h2>
              {landings.length === 0 && (
                <p class="mt-4 text-sm text-ink/60">Se crea después de la sesión de diagnóstico, con los resultados y la ruta sugerida.</p>
              )}
              <ul class="mt-4 space-y-3 text-sm">
                {landings.map((l) => (
                  <li class="flex items-center justify-between gap-3">
                    <a href={`/admin/landings/${l.id}`} class="font-semibold text-azul hover:underline">{l.titulo}</a>
                    <span class="admin-tag shrink-0">
                      {ETIQUETA_ESTADO_LANDING[estadoVisible(l)]} · {l.desbloqueadas}/{l.etapas}
                    </span>
                  </li>
                ))}
              </ul>
              <form method="post" class="mt-4">
                <input type="hidden" name="csrf" value={csrf} />
                <button name="accion" value="crear_landing" class="btn btn-outline-dark !py-2 !text-xs">Crear landing</button>
              </form>
            </section>

            <section class="admin-card">
              <h2 class="eyebrow text-ink/50">Estado</h2>
              <form method="post" class="mt-4 space-y-4">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="accion" value="estado" />
                <div>
                  <label for="estado" class="admin-label">Estado del pipeline</label>
                  <select id="estado" name="estado" class="admin-input">
                    {ESTADOS.map((e) => <option value={e.codigo} selected={datos.lead.estado === e.codigo}>{e.etiqueta}</option>)}
                  </select>
                </div>
                <div>
                  <label for="motivo_perdido" class="admin-label">Motivo (solo si es «Perdido»)</label>
                  <select id="motivo_perdido" name="motivo_perdido" class="admin-input">
                    <option value="">—</option>
                    {MOTIVOS_PERDIDO.map((m) => (
                      <option value={m.codigo} selected={datos.lead.motivo_perdido === m.codigo}>{m.etiqueta}</option>
                    ))}
                  </select>
                </div>
                <button type="submit" class="btn btn-outline-dark !py-2 !text-xs">Cambiar estado</button>
              </form>
            </section>

            <section class="admin-card">
              <h2 class="eyebrow text-ink/50">Historial de estados</h2>
              <ol class="mt-4 space-y-3 text-sm">
                {datos.historial.map((h) => (
                  <li class="border-l-2 border-celeste pl-3">
                    <p class="font-semibold">
                      {h.estado_anterior ? `${etiqueta(ESTADOS, h.estado_anterior)} → ` : ''}
                      {etiqueta(ESTADOS, h.estado_nuevo)}
                      {h.motivo_perdido && ` (${etiqueta(MOTIVOS_PERDIDO, h.motivo_perdido)})`}
                    </p>
                    <p class="text-ink/50">
                      {fechaHora(h.creado_el)} · {h.admin ?? (h.origen === 'formulario web' ? 'Formulario web' : 'Sistema')}
                    </p>
                  </li>
                ))}
              </ol>
            </section>

            <section class="admin-card text-sm">
              <h2 class="eyebrow text-ink/50">Consentimiento y bajas</h2>
              {datos.lead.consentimiento_el ? (
                <p class="mt-4">
                  {fechaHora(datos.lead.consentimiento_el)} · {datos.lead.consentimiento_origen}
                  <span class="block text-ink/50">Texto aceptado: «{datos.lead.consentimiento_texto}»</span>
                </p>
              ) : (
                <p class="mt-4 text-ink/60">Sin consentimiento registrado. No se le pueden enviar mails.</p>
              )}
              {datos.lead.baja_el && (
                <p class="mt-3 font-semibold text-[#a8412b]">Pidió no ser contactado el {fechaHora(datos.lead.baja_el)}.</p>
              )}
            </section>

            {datos.formularios.length > 0 && (
              <section class="admin-card text-sm">
                <h2 class="eyebrow text-ink/50">Envíos del formulario web</h2>
                <ul class="mt-4 space-y-3">
                  {datos.formularios.map((f) => (
                    <li>
                      <p class="font-semibold">{fechaHora(f.created_at)}</p>
                      <p class="text-ink/60">
                        {[f.resolver, f.tamano, envioMail[f.resend_status] ?? null].filter(Boolean).join(' · ')}
                        {f.ruta_referido && f.ruta_referido !== f.resolver && ` · vino por: ${f.ruta_referido}`}
                      </p>
                      {f.comentarios && <p class="mt-1 text-ink/70">{f.comentarios}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      </>
    )
  }
</AdminLayout>
