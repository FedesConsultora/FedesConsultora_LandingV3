---
// Página legal (Privacidad, Términos) a partir de src/content/legales.ts.
// Los marcadores [TEXTO LEGAL PENDIENTE: …] se resaltan para que se vean en la revisión.
import Base from '../layouts/Base.astro';
import type { DocumentoLegal } from '../content/legales';

interface Props {
  doc: DocumentoLegal;
}
const { doc } = Astro.props;

const PENDIENTE = /(\[TEXTO LEGAL PENDIENTE[^\]]*\])/;
const partes = (texto: string) => texto.split(PENDIENTE).map((t) => ({ t, pendiente: PENDIENTE.test(t) }));
---

<Base title={doc.meta.title} description={doc.meta.description} noindex>
  <section class="section pt-36 md:pt-48">
    <div class="container-fedes max-w-3xl">
      <p class="eyebrow text-azul">Legales</p>
      <h1 class="mt-6 text-4xl sm:text-5xl">{doc.titulo}</h1>
      <p class="mt-6 font-display text-sm text-ink/60">Última actualización: {doc.actualizado}</p>

      <div class="legal mt-12">
        {
          doc.secciones.map((s) => (
            <section>
              <h2>{s.titulo}</h2>
              {s.bloques.map((b) =>
                typeof b === 'string' ? (
                  <p>{partes(b).map((p) => (p.pendiente ? <mark>{p.t}</mark> : p.t))}</p>
                ) : 'lista' in b ? (
                  <ul>
                    {b.lista.map((item) => (
                      <li>{partes(item).map((p) => (p.pendiente ? <mark>{p.t}</mark> : p.t))}</li>
                    ))}
                  </ul>
                ) : (
                  <h3>{b.subtitulo}</h3>
                ),
              )}
            </section>
          ))
        }
        <p class="ver-tambien">
          {doc.verTambien.texto} <a href={doc.verTambien.href}>{doc.verTambien.label}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .legal section + section {
    margin-top: 2.5rem;
  }
  .legal h2 {
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .legal h3 {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
  }
  .legal p,
  .legal ul {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal li + li {
    margin-top: 0.5rem;
  }
  .legal mark {
    background: color-mix(in srgb, var(--color-celeste) 30%, transparent);
    color: var(--color-ink);
    padding: 0 0.25em;
  }
  .legal a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .legal a:hover {
    color: var(--color-azul);
  }
  .ver-tambien {
    margin-top: 3rem !important;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
</style>
