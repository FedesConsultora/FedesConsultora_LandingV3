---
// Franja de texto en movimiento continuo. El contenido va duplicado para el bucle sin cortes.
interface Props {
  items: string[];
}
const { items } = Astro.props;
const loop = [...items, ...items, ...items, ...items];
---

<div class="overflow-hidden border-y border-white/15 bg-ink py-5 text-white" aria-hidden="true">
  <div class="anim-marquee flex w-max items-center whitespace-nowrap">
    {
      [0, 1].map(() => (
        <div class="flex items-center">
          {loop.map((t) => (
            <span class="flex items-center font-display text-sm font-semibold uppercase tracking-[0.32em] text-white/70">
              <span class="px-8">{t}</span>
              <span class="h-1.5 w-1.5 rounded-full bg-accent" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
