---
// Línea de pasos del proceso y tarjeta de próxima acción, arriba de la ficha del lead.
// Cada botón es un POST a la ficha (funciona sin JavaScript).
import { aInputFechaHora } from '../../lib/pipeline';
import type { Accion, Seguimiento } from '../../lib/proceso';

interface Props {
  seguimiento: Seguimiento;
  fechaSesion: Date | null;
}
const { seguimiento: s, fechaSesion } = Astro.props;
const csrf = Astro.locals.admin?.csrf ?? '';

const fechaTexto = fechaSesion
  ? new Date(fechaSesion).toLocaleString('es-AR', {
      timeZone: 'America/Argentina/Buenos_Aires',
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      hour: '2-digit',
      minute: '2-digit',
    })
  : null;

const estilos = {
  hecho: 'border-azul bg-azul text-white',
  actual: 'border-azul bg-white text-azul ring-4 ring-azul/15',
  pendiente: 'border-ink/20 bg-white text-ink/30',
  omitido: 'border-dashed border-ink/25 bg-white text-ink/30',
};
const acciones = [s.accion, s.secundaria].filter(Boolean) as Accion[];
---

<section class="admin-card mt-6" aria-label="Seguimiento del lead">
  <ol class="flex gap-1 overflow-x-auto pb-2">
    {
      s.pasos.map((p, i) => (
        <li class="flex min-w-[88px] flex-1 flex-col items-center text-center">
          <div class="flex w-full items-center">
            <span class:list={['h-px flex-1', i === 0 ? 'bg-transparent' : p.estado === 'pendiente' ? 'bg-ink/15' : 'bg-azul']} />
            <span
              class:list={['flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 font-display text-xs font-bold', estilos[p.estado]]}
              aria-current={p.estado === 'actual' ? 'step' : undefined}
            >
              {p.estado === 'hecho' ? '✓' : i + 1}
            </span>
            <span class:list={['h-px flex-1', i === s.pasos.length - 1 ? 'bg-transparent' : s.pasos[i + 1].estado === 'pendiente' ? 'bg-ink/15' : 'bg-azul']} />
          </div>
          <span
            class:list={[
              'mt-2 font-display text-[11px] leading-tight',
              p.estado === 'actual' ? 'font-bold text-ink' : p.estado === 'hecho' ? 'text-ink/70' : 'text-ink/35',
            ]}
          >
            {p.etiqueta}
            {p.estado === 'omitido' && <span class="block">(omitido)</span>}
          </span>
        </li>
      ))
    }
  </ol>

  <div class="mt-5 grid gap-4 border-t border-ink/10 pt-5 md:grid-cols-2">
    {
      acciones.map((a, i) => (
        <div class:list={[i === 0 ? '' : 'md:border-l md:border-ink/10 md:pl-6']}>
          <p class="eyebrow text-ink/50">{i === 0 ? 'Próxima acción' : 'También'}</p>
          <p class:list={['mt-2 font-display font-semibold', i === 0 ? 'text-lg' : 'text-base']}>{a.titulo}</p>
          {i === 0 && a.tipo === 'ninguna' && fechaTexto && s.pasos.some((p) => p.clave === 'sesion_agendada' && p.estado === 'actual') && (
            <p class="mt-1 text-ink/70 first-letter:uppercase">{fechaTexto}</p>
          )}
          {a.detalle && <p class="mt-1 text-sm text-ink/60">{a.detalle}</p>}

          {a.tipo === 'estado' && (
            <form method="post" class="mt-3">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="accion" value="estado" />
              <input type="hidden" name="estado" value={a.estado} />
              <button class:list={['btn !px-5 !py-2 !text-xs', i === 0 ? 'btn-primary' : 'btn-outline-dark']}>{a.boton}</button>
            </form>
          )}
          {a.tipo === 'agendar' && (
            <form method="post" class="mt-3 flex flex-wrap items-center gap-2">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="accion" value="agendar" />
              <label class="sr-only" for={`fecha-sesion-${i}`}>Fecha y hora de la sesión (Buenos Aires)</label>
              <input id={`fecha-sesion-${i}`} name="fecha_sesion" type="datetime-local" required value={aInputFechaHora(fechaSesion)} class="admin-input !mt-0 !w-auto" />
              <button class:list={['btn !px-5 !py-2 !text-xs', i === 0 ? 'btn-primary' : 'btn-outline-dark']}>{a.boton}</button>
            </form>
          )}
          {a.tipo === 'crear_landing' && (
            <form method="post" class="mt-3">
              <input type="hidden" name="csrf" value={csrf} />
              <button name="accion" value="crear_landing" class="btn btn-primary !px-5 !py-2 !text-xs">{a.boton}</button>
            </form>
          )}
          {a.tipo === 'entregar_landing' && (
            <form method="post" class="mt-3">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="landing_id" value={a.landingId} />
              <button name="accion" value="entregar_landing" class="btn btn-primary !px-5 !py-2 !text-xs">{a.boton}</button>
            </form>
          )}
          {a.tipo === 'editar_landing' && (
            <a href={`/admin/landings/${a.landingId}`} class:list={['btn mt-3 !px-5 !py-2 !text-xs', i === 0 ? 'btn-primary' : 'btn-outline-dark']}>
              {a.boton}
            </a>
          )}
        </div>
      ))
    }
  </div>
</section>
