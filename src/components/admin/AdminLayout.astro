---
// Marco común de las páginas del panel: encabezado, navegación y cierre de sesión.
import Base from '../../layouts/Base.astro';
import { site } from '../../content/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { label: 'Inicio', href: '/admin', activo: path === '/admin' },
  {
    label: 'Leads',
    href: '/admin/leads',
    activo: (path.startsWith('/admin/leads') && path !== '/admin/leads/nuevo') || path.startsWith('/admin/landings'),
  },
  { label: 'Nuevo lead', href: '/admin/leads/nuevo', activo: path === '/admin/leads/nuevo' },
];
---

<Base title={`${title} | Panel | ${site.name}`} description="Panel de administración." noindex bare>
  <div class="min-h-[100svh] bg-ink/[0.02]">
    <header class="border-b border-ink/10 bg-ink text-white">
      <div class="container-fedes flex h-16 items-center justify-between gap-6 md:h-20">
        <div class="flex items-center gap-8">
          <a href="/admin"><img src={site.logo} alt={site.name} width="2620" height="976" class="h-8 w-auto" /></a>
          <nav class="flex items-center gap-5">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  class:list={['font-display text-sm font-semibold', n.activo ? 'text-celeste' : 'text-white/75 hover:text-white']}
                  aria-current={n.activo ? 'page' : undefined}
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="flex items-center gap-6">
          <a href="https://analytics.google.com" target="_blank" rel="noopener" class="hidden font-display text-sm font-medium text-white/75 hover:text-celeste lg:inline">
            Ver tráfico en Google Analytics
          </a>
          <span class="hidden font-display text-sm text-white/60 sm:inline">{Astro.locals.admin?.nombre}</span>
          <button id="logout" type="button" class="font-display text-sm font-semibold text-white hover:text-celeste">Salir</button>
        </div>
      </div>
    </header>

    <main class="container-fedes py-10 md:py-14">
      <slot />
    </main>
  </div>

  <script>
    // Evita envíos dobles (por ejemplo, un doble clic en "Crear landing"): mientras un formulario
    // se envía, se ignoran nuevos envíos y sus botones quedan deshabilitados.
    document.addEventListener('submit', (ev) => {
      const form = ev.target as HTMLFormElement;
      if (ev.defaultPrevented) return;
      if (form.dataset.enviando) {
        ev.preventDefault();
        return;
      }
      form.dataset.enviando = '1';
      // Se deshabilitan después de que el navegador tomó el valor del botón apretado.
      setTimeout(() =>
        form.querySelectorAll('button:not([disabled])').forEach((b) => {
          (b as HTMLButtonElement).disabled = true;
          (b as HTMLButtonElement).dataset.reactivar = '1';
        }),
      );
    });
    // Al volver con el botón "atrás", la página puede venir de la caché con los botones deshabilitados.
    window.addEventListener('pageshow', () => {
      document.querySelectorAll<HTMLFormElement>('form[data-enviando]').forEach((f) => {
        delete f.dataset.enviando;
        f.querySelectorAll<HTMLButtonElement>('button[data-reactivar]').forEach((b) => {
          b.disabled = false;
          delete b.dataset.reactivar;
        });
      });
    });

    document.getElementById('logout')?.addEventListener('click', async () => {
      const csrf = document.querySelector<HTMLMetaElement>('meta[name="csrf-token"]')?.content ?? '';
      await fetch('/api/admin/logout', { method: 'POST', headers: { 'x-csrf-token': csrf } });
      location.href = '/admin/login';
    });
  </script>
</Base>
