# Variables públicas: se incorporan al HTML durante el build.
PUBLIC_SITE_URL=https://fedesconsultora.com
PUBLIC_INDEXABLE=false
PUBLIC_GA_ID=

# Secretos/configuración de servidor: runtime, no se pasan a `docker build`.
POSTGRES_URL=
SESSION_SECRET=
LANDING_TOKEN_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Configuración de servidor runtime.
CONTACT_TO=info@fedesconsultora.com
CONTACT_FROM=Web Fedes <onboarding@resend.dev>
MAIL_FROM=
MAIL_LINKS_URL=https://fedesconsultora.com
MAIL_PERMITIDOS=
MAIL_RESPUESTAS_DOMINIO=
MAIL_COPIA_RESPUESTAS=

# Build ID público opcional; Docker lo asigna al SHA de Git. No contiene secretos.
BUILD_SHA=
