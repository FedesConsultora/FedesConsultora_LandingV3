# Copiar a .env (local) o cargar en Vercel > Settings > Environment Variables.
RESEND_API_KEY=
# Destino de las solicitudes (provisorio)
CONTACT_TO=info@fedesconsultora.com
# Remitente. Con onboarding@resend.dev Resend solo entrega al mail dueño de la cuenta;
# para enviar a info@fedesconsultora.com hay que verificar el dominio en Resend.
CONTACT_FROM=Web Fedes <onboarding@resend.dev>
# Poner en "true" recién al lanzar el dominio final (quita el noindex).
PUBLIC_INDEXABLE=false

# Google Analytics 4: Measurement ID de la propiedad (ej. G-XXXXXXXXXX). Sin esto, no se carga.
PUBLIC_GA_ID=

# Base de datos del panel /admin (Postgres en Neon, integración nativa de Vercel). La agrega
# Vercel sola al conectar la base desde la pestaña "Storage" del proyecto; no hace falta cargarla a mano.
POSTGRES_URL=

# Panel /admin: los usuarios viven en la base (tabla admins). Se crean con `npm run admin:crear`,
# corrido en tu propia terminal. ADMIN_USER y ADMIN_PASSWORD_HASH ya no se usan.
# Secreto del servidor: deriva los tokens CSRF del panel y los hashes de IP del límite de intentos.
# Cadena larga y al azar, distinta en cada entorno (ej. `openssl rand -base64 48`).
SESSION_SECRET=

# Landings privadas: clave para cifrar la copia del token de cada link (AES-256-GCM).
# 32 bytes en base64: `openssl rand -base64 32`. Distinta en cada entorno. Si se pierde o se
# cambia, los links existentes siguen funcionando pero el panel ya no puede mostrarlos: habría
# que generar links nuevos.
LANDING_TOKEN_KEY=

# Mails del panel (fase 2). Sin RESEND_API_KEY los mails quedan simulados (no salen).
# Remitente (por defecto "Fedes Consultora <info@fedesconsultora.com>"; el dominio tiene que estar verificado en Resend).
MAIL_FROM=
# Base de los links de los mails (seguimiento, landing, baja). En producción, el dominio del sitio.
MAIL_LINKS_URL=
# Solo para pruebas: si se completa, solo se envían de verdad los mails a estas direcciones (separadas por coma).
MAIL_PERMITIDOS=
# Subdominio de recepción de respuestas configurado en Resend (ej. r.fedesconsultora.com). Sin esto, las respuestas van al remitente.
MAIL_RESPUESTAS_DOMINIO=
# Copia de cada respuesta recibida (decidido el 29/09: info@fedesconsultora.com).
MAIL_COPIA_RESPUESTAS=
# Secreto de firma del webhook de Resend (whsec_...), para /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=
