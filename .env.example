# Copiar a .env (local) o cargar en Vercel > Settings > Environment Variables.
RESEND_API_KEY=
# Destino de las solicitudes (provisorio)
CONTACT_TO=info@fedesconsultora.com
# Remitente. Con onboarding@resend.dev Resend solo entrega al mail dueño de la cuenta;
# para enviar a info@fedesconsultora.com hay que verificar el dominio en Resend.
CONTACT_FROM=Web Fedes <onboarding@resend.dev>
# Poner en "true" recién al lanzar el dominio final (quita el noindex).
PUBLIC_INDEXABLE=false

# Google Analytics 4: Measurement ID de la propiedad (ej. G-XXXXXXXXXX). Sin esto, no se carga.
PUBLIC_GA_ID=

# Base de datos del panel /admin (leads del formulario). La agrega Vercel solo al conectar
# Postgres desde la pestaña "Storage" del proyecto; no hace falta cargarla a mano.
POSTGRES_URL=

# Panel /admin: generar con `node scripts/create-admin.mjs` (correlo en tu propia terminal).
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# Secreto para firmar la cookie de sesión del panel. Cualquier cadena larga y al azar.
SESSION_SECRET=
