# Copiar a .env (local) o cargar en Vercel > Settings > Environment Variables.
RESEND_API_KEY=
# Destino de las solicitudes (provisorio)
CONTACT_TO=info@fedesconsultora.com
# Remitente. Con onboarding@resend.dev Resend solo entrega al mail dueño de la cuenta;
# para enviar a info@fedesconsultora.com hay que verificar el dominio en Resend.
CONTACT_FROM=Web Fedes <onboarding@resend.dev>
# Poner en "true" recién al lanzar el dominio final (quita el noindex).
PUBLIC_INDEXABLE=false

# Google Analytics 4: Measurement ID de la propiedad (ej. G-XXXXXXXXXX). Sin esto, no se carga.
PUBLIC_GA_ID=

# Base de datos del panel /admin (Postgres en Neon, integración nativa de Vercel). La agrega
# Vercel sola al conectar la base desde la pestaña "Storage" del proyecto; no hace falta cargarla a mano.
POSTGRES_URL=

# Panel /admin: los usuarios viven en la base (tabla admins). Se crean con `npm run admin:crear`,
# corrido en tu propia terminal. ADMIN_USER y ADMIN_PASSWORD_HASH ya no se usan.
# Secreto del servidor: deriva los tokens CSRF del panel y los hashes de IP del límite de intentos.
# Cadena larga y al azar, distinta en cada entorno (ej. `openssl rand -base64 48`).
SESSION_SECRET=
